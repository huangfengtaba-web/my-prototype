{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/twin", "destination": "/vendor-twin/twin.html" },
    { "source": "/twin/:path*", "destination": "/vendor-twin/:path*" },
    { "source": "/gtx-layout-map.json", "destination": "/vendor-twin/gtx-layout-map.json" },
    { "source": "/gtx-catalog.json", "destination": "/vendor-twin/gtx-catalog.json" },
    { "source": "/js/:path*", "destination": "/vendor-twin/js/:path*" },
    { "source": "/src/pages/_shared/:path*", "destination": "/src/pages/_shared/:path*" },
    { "source": "/prototypes", "destination": "/prototypes/index.html" },
    { "source": "/prototypes/:path*", "destination": "/prototypes/:path*" },
    { "source": "/simulation", "destination": "/src/pages/simulation" },
    { "source": "/ai-agent", "destination": "/src/pages/ai-agent" },
    { "source": "/ai-workflow", "destination": "/src/pages/ai-workflow" },
    { "source": "/scheduling-test", "destination": "/src/pages/scheduling-test" },
    { "source": "/reports", "destination": "/src/pages/reports" },
    { "source": "/litho-schedule", "destination": "/src/pages/litho-schedule" },
    { "source": "/reticle-schedule", "destination": "/src/pages/reticle-schedule" },
    { "source": "/logs", "destination": "/src/pages/logs" },
    { "source": "/config", "destination": "/src/pages/config" },
  ]
}
