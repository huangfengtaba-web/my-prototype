{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "venv:create",
      "type": "shell",
      "command": "python",
      "args": ["-m", "venv", ".venv"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "创建虚拟环境（需先在系统装好 Python 3.11）"
    },
    {
      "label": "install:pip",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pip", "install", "-r", "backend/requirements.txt"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "安装后端依赖（pulp/fastapi/uvicorn/pytest/PyYAML/matplotlib）"
    },
    {
      "label": "run:solver",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "backend.solver", "run"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "build",
      "detail": "命令行跑六步 MILP，输出到 backend/solver/output/"
    },
    {
      "label": "run:api",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "backend.app.api:app", "--reload", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "启动 FastAPI 后端 http://127.0.0.1:8000（Ctrl+Shift+B 默认跑这个，终端会一直占着）"
    },
    {
      "label": "run:web",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "detail": "启动前端 Vite http://localhost:5173"
    },
    {
      "label": "run:pytest",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "tests/", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test",
      "detail": "跑全部测试，期望全绿"
    }
  ]
}
