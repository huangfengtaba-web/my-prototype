# GTX FSO Litho · 环境变量样例
# 复制为 .env 后按需修改；.env 不入版本库（见 .gitignore）

# --- 后端（Railway / 本地 uvicorn 读取） ---
# CORS 白名单，逗号分隔；生产改为 https://你的前端域名.vercel.app
LITHO_CORS_ORIGINS=http://localhost:5173
# 求解器切换位：CBC（默认，PuLP 自带）｜Gurobi｜COPT（后两者需另装 license）
LITHO_SOLVER=CBC
# 单次求解超时（秒）
LITHO_TIME_LIMIT_S=60

# --- 前端（Vercel 构建时注入 VITE_ 前缀变量） ---
# 前端调后端的地址；本地开发默认 http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- AI Agent（可选；不配置则 Agent 走规则模式，功能可用但无自主决策） ---
# OpenAI 兼容网关，如 https://api.openai.com/v1 或自建 one-api 网关
LLM_API_BASE=
LLM_API_KEY=
# 模型名，如 gpt-4o-mini / glm-4-flash / qwen-plus
LLM_MODEL=gpt-4o-mini

# --- Dify 线上工作流（用户在自己线上 Dify 搭建后填写）---
# 不填 = 自动降级本地模式，/api/workflow/run 返回 mode=local_fallback
# 警告：这三个 Key 只能后端读，禁止出现在任何前端代码里
DIFY_BASE=https://api.dify.ai/v1
DIFY_KEY_DAILY_SCHEDULING=
DIFY_KEY_SCENARIO_COMPARE=
DIFY_KEY_QA_CHATFLOW=

# 供线上 Dify 的 HTTP 节点回调本地后端（内网穿透地址）
# 用法：cloudflared tunnel --url http://localhost:8000
API_PUBLIC_BASE=

# --- WPS 文档生成（仅本地 Windows 可用）---
# 云端部署（Linux / Vercel / Railway）必须设 0，否则 COM 必失败
DOCGEN_ENABLED=1
DOCGEN_OUT_DIR=./output/doc
